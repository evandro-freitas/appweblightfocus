# Supabase EXTERNO (projeto do usuário — não é o Lovable Cloud)
# Crie um projeto em https://supabase.com, rode o SQL de supabase/schema.sql
# no SQL Editor e copie as chaves em Project Settings > API.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Sem essas variáveis, o app funciona em memória com dados de exemplo.
