# Credenciais do seu projeto Supabase.
# Em produção/preview elas ficam salvas como secrets do projeto
# (SUPABASE_URL e SUPABASE_ANON_KEY) e são lidas no servidor.
# Localmente você pode usar as variáveis VITE_ abaixo.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
